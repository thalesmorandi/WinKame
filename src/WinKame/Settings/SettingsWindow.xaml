<Window x:Class="WinKame.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WinKame"
        xmlns:core="clr-namespace:WinKame.Core;assembly=WinKame.Core"
        Title="{l:T 'WinKame - Configurações'}" Width="880" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="Status" VerticalAlignment="Center" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:T 'Cancelar'}" MinWidth="90" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Content="{l:T 'Salvar'}" MinWidth="110" Margin="8,0,0,0" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="12,12,12,0" TabStripPlacement="Left">
            <!-- General -->
            <TabItem Header="{l:T 'Geral'}" Tag="general">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,6,20,20" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{l:T 'Geral'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <CheckBox x:Name="DragEnabled" Content="{l:T 'Abrir a roda ao arrastar arquivos e tocar uma tecla'}" />
                        <TextBlock Text="{l:T 'Onde salvar os resultados'}" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <RadioButton x:Name="OutSame" Content="{l:T 'Na mesma pasta do original'}" GroupName="out" />
                        <RadioButton x:Name="OutCustom" Content="{l:T 'Sempre nesta pasta:'}" GroupName="out" Margin="0,6,0,0" />
                        <DockPanel Margin="24,6,0,0">
                            <Button DockPanel.Dock="Right" Content="{l:T 'Escolher…'}" Margin="8,0,0,0" Click="BrowseOutput_Click" />
                            <TextBox x:Name="OutFolder" />
                        </DockPanel>
                        <CheckBox x:Name="Reveal" Content="{l:T 'Mostrar o resultado no Explorer ao terminar'}" Margin="0,16,0,0" />
                        <TextBlock Text="{l:T 'Os originais nunca são alterados: cada resultado é um arquivo novo.'}" Opacity="0.65" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{l:T 'Cor de destaque'}" FontWeight="SemiBold" Margin="0,22,0,8" />
                        <WrapPanel x:Name="AccentSwatches" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox x:Name="AccentHex" Width="110" MaxLength="7" />
                            <Border CornerRadius="10" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="PDF" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" />
                            </Border>
                            <ProgressBar Style="{StaticResource SlimProgress}" Width="120" Value="60" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{l:T 'Usada na roda, no cartão de tarefas e na prateleira.'}" Opacity="0.65" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Idioma / Language" FontWeight="SemiBold" Margin="0,22,0,6" />
                        <ComboBox x:Name="LanguageBox" SelectedValuePath="Tag" HorizontalAlignment="Left" MinWidth="260">
                            <ComboBoxItem Content="{l:T 'Automático (idioma do Windows)'}" Tag="auto" />
                            <ComboBoxItem Content="Português" Tag="pt" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                        <TextBlock x:Name="LanguageNote" Text="{l:T 'Reinicie o WinKame para aplicar o novo idioma.'}" Opacity="0.65" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Keys -->
            <TabItem Header="{l:T 'Teclas e roda'}" Tag="keys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,6,20,20" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{l:T 'Teclas e roda'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,14"
                                   Text="{l:T 'Comece a arrastar um arquivo e toque rapidamente uma tecla. A roda abre sob o cursor e fica aberta até você soltar. Com a roda aberta, toque outra tecla para trocar de roda.'}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T 'Converter formatos'}" VerticalAlignment="Center" />
                            <ComboBox x:Name="KeyConvert" Grid.Column="1" Margin="0,4" />
                            <TextBlock Text="{l:T 'Ferramentas'}" Grid.Row="1" VerticalAlignment="Center" />
                            <ComboBox x:Name="KeyTools" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                            <TextBlock Text="{l:T 'Ações de arquivo'}" Grid.Row="2" VerticalAlignment="Center" />
                            <ComboBox x:Name="KeyActions" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                            <TextBlock Text="{l:T 'Ações personalizadas'}" Grid.Row="3" VerticalAlignment="Center" />
                            <ComboBox x:Name="KeyCustom" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                        </Grid>
                        <TextBlock x:Name="TapLabel" FontWeight="SemiBold" Margin="0,22,0,4" />
                        <Slider x:Name="TapMs" Minimum="200" Maximum="900" TickFrequency="25" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="ThresholdLabel" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <Slider x:Name="Threshold" Minimum="4" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="ScaleLabel" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <Slider x:Name="WheelScale" Minimum="0.7" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.65" Margin="0,16,0,0"
                                   Text="{l:T 'Segurar Ctrl ou Shift antes de começar a arrastar continua funcionando como no Explorer (copiar/mover). Só um toque rápido depois que o arrasto começou abre a roda.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tools -->
            <TabItem Header="{l:T 'Ferramentas'}" Tag="tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,6,20,20" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="{l:T 'Ferramentas externas'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"
                                   Text="{l:T 'Quase tudo já vem no WinKame. Os programas abaixo só melhoram casos específicos, e tudo roda no seu PC, sem enviar nada para a internet.'}" />
                        <StackPanel x:Name="ToolRows" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Custom actions -->
            <TabItem Header="{l:T 'Ações personalizadas'}" Tag="custom">
                <DockPanel Margin="20,6,20,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{l:T 'Ações personalizadas'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"
                                   Text="{l:T 'Rode qualquer programa ou script com os arquivos que você soltar. Cada ação vira uma fatia da roda escolhida.'}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Content="&#xE710;" FontFamily="{StaticResource IconFont}" ToolTip="{l:T 'Nova ação'}" Click="AddAction_Click" Margin="0,0,4,0" />
                                <Button Content="&#xE8C8;" FontFamily="{StaticResource IconFont}" ToolTip="{l:T 'Duplicar'}" Click="DuplicateAction_Click" Margin="0,0,4,0" />
                                <Button Content="&#xE74D;" FontFamily="{StaticResource IconFont}" ToolTip="{l:T 'Remover'}" Click="RemoveAction_Click" Margin="0,0,4,0" />
                                <Button x:Name="ExamplesButton" Content="{l:T 'Exemplos'}" Click="Examples_Click" />
                            </WrapPanel>
                            <ListBox x:Name="ActionList" DisplayMemberPath="Name" SelectionChanged="ActionList_SelectionChanged" />
                        </DockPanel>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ActionEditor">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Nome'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" TextChanged="ActionName_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{l:T 'Ícone'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Glyph, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource IconFont}" FontSize="16" TextAlignment="Center" ToolTip="{l:T 'Um emoji, uma letra ou um ícone Segoe'}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel x:Name="GlyphPicker" Margin="0,6,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Aparece na roda'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Wheel}">
                                            <ComboBoxItem Content="{l:T 'Personalizadas'}" Tag="custom" />
                                            <ComboBoxItem Content="{l:T 'Ferramentas'}" Tag="tools" />
                                            <ComboBoxItem Content="{l:T 'Ações de arquivo'}" Tag="actions" />
                                            <ComboBoxItem Content="{l:T 'Converter'}" Tag="convert" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{l:T 'Para quais arquivos'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T '* para todos, folder para pastas, ou extensões: jpg, png'}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{l:T 'Comando'}" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:T 'Procurar…'}" Margin="8,0,0,0" Click="BrowseCommand_Click" />
                                    <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" />
                                </DockPanel>
                                <TextBlock Text="{l:T 'Argumentos'}" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                         AcceptsReturn="False" TextWrapping="Wrap" MinHeight="54" />
                                <TextBlock x:Name="PlaceholderHelp" TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="0,6,0,0" />
                                <TextBlock Text="{l:T 'Pasta de trabalho (opcional)'}" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" ToolTip="{l:T 'Vazio = pasta do arquivo'}" />
                                <TextBlock Text="{l:T 'Execução'}" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Mode}" HorizontalAlignment="Left" MinWidth="280">
                                    <ComboBoxItem Content="{l:T 'Uma vez para cada arquivo'}" Tag="{x:Static core:CustomRunMode.PerFile}" />
                                    <ComboBoxItem Content="{l:T 'Uma vez com todos os arquivos ({paths})'}" Tag="{x:Static core:CustomRunMode.AllAtOnce}" />
                                </ComboBox>
                                <CheckBox Content="{l:T 'Mostrar a janela do programa'}" IsChecked="{Binding ShowWindow}" Margin="0,10,0,0" />
                                <CheckBox Content="{l:T 'Esperar terminar (mostra progresso e o resultado)'}" IsChecked="{Binding WaitForExit}" Margin="0,6,0,0" />
                                <CheckBox Content="{l:T 'Ativa'}" IsChecked="{Binding Enabled}" Margin="0,6,0,0" />
                                <Button Content="{l:T 'Testar com um arquivo…'}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="TestAction_Click" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="NoAction" Grid.Column="2" Text="{l:T 'Crie uma ação com + ou comece por um exemplo.'}" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Integration -->
            <TabItem Header="{l:T 'Integração'}" Tag="integration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,6,20,20" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="{l:T 'Integração com o Windows'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <CheckBox x:Name="StartWithWindows" Content="{l:T 'Iniciar com o Windows'}" />
                        <CheckBox x:Name="ContextMenuCheck" Content="{l:T 'Menu do botão direito no Explorer: Abrir no WinKame'}" Margin="0,12,0,0" />
                        <TextBlock x:Name="ContextMenuHint" TextWrapping="Wrap" Opacity="0.65" Margin="26,4,0,0" FontSize="12"
                                   Text="{l:T 'No Windows 11 fica em Mostrar mais opções (Shift+F10). A roda abre no cursor e funciona com clique.'}" />
                        <CheckBox x:Name="SendTo" Content="{l:T 'Menu Enviar para › WinKame'}" Margin="0,12,0,0" />
                        <TextBlock x:Name="SendToHint" TextWrapping="Wrap" Opacity="0.65" Margin="26,4,0,0" FontSize="12"
                                   Text="{l:T 'Bom para seleções grandes: envia todos os arquivos de uma vez.'}" />
                        <TextBlock x:Name="IntegrationNote" Text="{l:T 'Tudo é registrado só para o seu usuário, sem precisar de administrador.'}" Opacity="0.65" Margin="0,20,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About -->
            <TabItem Header="{l:T 'Sobre'}" Tag="about">
                <StackPanel Margin="20,6,20,20" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="WinKame" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Opacity="0.7" Margin="0,2,0,6" />
                    <TextBlock Margin="0,0,0,2" FontWeight="SemiBold">
                        <Run Text="{l:T 'Um produto da'}" />
                        <Hyperlink NavigateUri="https://morandi.cloud" RequestNavigate="Link_RequestNavigate">morandi.cloud</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{l:T 'Criado por Thales de Oliveira Morandi.'}" Opacity="0.8" Margin="0,0,0,14" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{l:T 'Conversor de arquivos offline para Windows. Arraste, toque uma tecla e solte numa fatia da roda. Tudo acontece no seu computador: nenhum arquivo é enviado para a internet.'}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="{l:T 'Inclui FFmpeg (GPLv3, build de gyan.dev), Magick.NET (ImageMagick), PDFsharp, PdfPig, Open XML SDK, HtmlToOpenXml, Markdig, ReverseMarkdown, AngleSharp, RtfPipe, ClosedXML e SharpCompress. Usa o WebView2 do Windows e, quando instalados, o Microsoft Office, o LibreOffice e o Ghostscript. Licenças em THIRD-PARTY-NOTICES.txt.'}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12" Opacity="0.85"
                               Text="{l:T 'Copyright (C) 2026 Thales de Oliveira Morandi. O WinKame é software livre: você pode redistribuí-lo e modificá-lo sob os termos da GNU GPL versão 3 ou posterior. Ele é distribuído SEM NENHUMA GARANTIA.'}" />
                    <TextBlock Margin="0,8,0,0" FontSize="12">
                        <Hyperlink NavigateUri="https://github.com/thalesmorandi/WinKame" RequestNavigate="Link_RequestNavigate"><Run Text="{l:T 'Código-fonte no GitHub'}" /></Hyperlink>
                        <Run Text="  ·  " />
                        <Hyperlink NavigateUri="LICENSE.txt" RequestNavigate="LocalFile_RequestNavigate"><Run Text="{l:T 'Licença'}" /></Hyperlink>
                        <Run Text="  ·  " />
                        <Hyperlink NavigateUri="https://winkame.morandi.cloud" RequestNavigate="Link_RequestNavigate">winkame.morandi.cloud</Hyperlink>
                    </TextBlock>
                    <Button Content="{l:T 'Abrir pasta de configurações'}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenSettingsFolder_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
