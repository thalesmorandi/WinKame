<Application x:Class="WinKame.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Colors for the custom-drawn surfaces (wheel, job toasts, shelf). -->
        <Color x:Key="AccentColor">#FFFF8A1F</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#33FF8A1F" />
        <!-- Opaque on purpose: on transparent windows, translucent fills let the desktop bleed through. -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1E1E21" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF2B2B2F" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF37373C" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B6B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF6BD48A" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji, Segoe UI Symbol, Segoe UI</FontFamily>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7" />
        </Style>

        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
