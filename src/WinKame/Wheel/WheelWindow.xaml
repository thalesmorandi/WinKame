<Window x:Class="WinKame.Wheel.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKame"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- An almost invisible fill keeps the whole square hit-testable, so drags land on us. -->
    <Grid x:Name="Root" Background="#01000000">
        <Grid x:Name="Body" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Zoom" ScaleX="0.88" ScaleY="0.88" />
            </Grid.RenderTransform>
            <Canvas x:Name="Ring" />
            <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                    CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" />
                </Border.Effect>
                <StackPanel x:Name="Chips" Orientation="Horizontal" />
            </Border>
        </Grid>
    </Grid>
</Window>
