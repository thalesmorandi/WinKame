<Window x:Class="WinKame.Jobs.JobsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WinKame"
        Title="{l:T 'WinKame - tarefas'}"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </Window.Resources>
    <Border Margin="14" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <StackPanel Margin="4">
            <DockPanel Margin="12,8,6,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{l:T 'Fechar'}" Click="Close_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Limpar'}" Click="Clear_Click" />
                <TextBlock Text="WinKame" Foreground="{StaticResource TextDimBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6,2,6,6" Padding="12,10" CornerRadius="9" Background="{StaticResource SurfaceRaisedBrush}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,8,0,0" Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                             Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           MaxHeight="90" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasError, Converter={StaticResource Vis}}" />
                                <WrapPanel Margin="-6,6,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Cancelar'}" Click="Cancel_Click"
                                            Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Mostrar no Explorer'}" Click="Reveal_Click"
                                            Visibility="{Binding CanReveal, Converter={StaticResource Vis}}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding InstallLabel}" Click="Install_Click"
                                            Visibility="{Binding CanInstall, Converter={StaticResource Vis}}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Copiar erro'}" Click="CopyError_Click"
                                            Visibility="{Binding HasError, Converter={StaticResource Vis}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
