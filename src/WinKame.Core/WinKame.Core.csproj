<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Only ship library translations for the app's own languages. -->
    <SatelliteResourceLanguages>en;pt;pt-BR</SatelliteResourceLanguages>
    <RootNamespace>WinKame.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlToOpenXml.dll" Version="3.5.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- T("...") translates interface text everywhere. -->
    <Using Include="WinKame.Core.L" Static="true" />
  </ItemGroup>

</Project>
